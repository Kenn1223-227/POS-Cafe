{
  "name": "cafe-pos-backend",
  "version": "1.0.0",
  "description": "Backend API cho hệ thống POS quản lý quán cà phê",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "print-bridge": "node local-print-bridge/bridge-server.js",
    "hash-passwords": "node scripts/hash-passwords.js",
    "db:migrate": "node scripts/run-migration.js",
    "db:migrate:test": "node scripts/run-migration.js --base --env-test all",
    "pack:clean": "node scripts/pack-clean.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:p0-e2e": "node --test tests/integration/p0-e2e-flows.spec.js",
    "test:p1-ops": "node --test tests/integration/p1-pilot-ops.spec.js",
    "test:v3-gate": "node --test tests/integration/v3-p0-gate.spec.js",
    "test:wave1": "node --test tests/unit/vietqrEmvco.test.js tests/unit/printBridgeSecurity.test.js tests/unit/wave1CoreLogic.test.js tests/integration/00-rls-guard.test.js tests/integration/wave1-*.test.js",
    "test:wave2": "node --test tests/unit/safeWac.test.js tests/unit/printBuilders.test.js tests/integration/wave2-idempotency-pnl.test.js tests/realtime/redis-socket-cluster.test.js tests/realtime/graceful-shutdown.test.js tests/e2e/qa01-pwa-offline-outbox.spec.js tests/e2e/pos-split-brain-modals.spec.js tests/e2e/print-bridge-security.spec.js",
    "test:wave3a": "node --test tests/unit/taxCalculator.test.js tests/unit/kdsRoutingAndPrivacy.test.js tests/integration/wave3a-tax-einvoice-nd13.test.js tests/realtime/isolation-3tier-86.test.js tests/realtime/kds-delta-sync.test.js",
    "test:wave3b": "node --test tests/unit/kioskQrToken.test.js tests/unit/viSearchAndMigration.test.js tests/integration/wave3b-hr3-storage-awaiting.test.js tests/e2e/pos-ergonomics-cfd-barcode.spec.js",
    "test:wave4a": "node --test tests/unit/wave4aEngines.test.js tests/integration/wave4a-chain-ops-hr.test.js tests/e2e/wave4a-qr-modifiers-labor-chart.spec.js",
    "test:wave4b": "node --test tests/unit/wave4bScaleGuards.test.js tests/integration/wave4b-businessday-replica-rls.test.js tests/e2e/wave4b-architecture-ci.spec.js",
    "test:load:k6": "k6 run tests/load/k6-pos-25tps.js",
    "test:phanhe7": "node scripts/test-phanhe7-unit.js",
    "test:phanhe1": "node scripts/test-phanhe1-unit.js",
    "test:phanhe1:integration": "node scripts/test-phanhe1-integration.js",
    "test:phanhe2": "node scripts/test-phanhe2-kds.js",
    "test:phanhe3": "node scripts/test-phanhe3-payment-shift.js",
    "test:phanhe4": "node scripts/test-phanhe4-inventory-cogs.js",
    "test:security": "node scripts/test-tenant-isolation.js",
    "test": "node scripts/test-tenant-isolation.js"
  },
  "keywords": [
    "pos",
    "cafe",
    "express",
    "socket.io"
  ],
  "author": "Khang",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/server": "^1.9.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  }
}
