# Biến VITE_* được nhúng vào mã chạy ở trình duyệt => công khai, tuyệt đối không đặt secret ở đây.
# Môi trường Local:
# VITE_API_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000

# Môi trường Pilot / Production (Render Backend):
# VITE_API_URL=https://pos-api.onrender.com/api
# VITE_SOCKET_URL=https://pos-api.onrender.com

# LƯU Ý CHO THIẾT BỊ IPAD / SAFARI (CHỐNG MẤT COOKIE DO CHÍNH SÁCH ITP - INTELLIGENT TRACKING PREVENTION):
# - Khuyến nghị cấu hình chung root domain:
#     * Frontend: https://pos.domain.vn
#     * Backend:  https://api.domain.vn
#   Khi chung root domain, Backend cấu hình COOKIE_SAMESITE=Lax (Safari chấp nhận cookie HttpOnly an toàn).
# - Nếu dùng khác domain (ví dụ Frontend trên Vercel: https://pos.vercel.app và Backend trên Render: https://pos-api.onrender.com):
#     * Backend BẮT BUỘC cấu hình COOKIE_SAMESITE=None (tự động ép Secure=true).
VITE_API_URL=https://pos.domain.vn/api
VITE_SOCKET_URL=https://pos.domain.vn
