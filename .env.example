PORT=3000

# Chuỗi kết nối PostgreSQL (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# BẮT BUỘC >= 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Domain frontend được phép gọi API/Socket, ngăn cách bằng dấu phẩy (để trống = cho phép mọi origin, KHÔNG nên dùng khi chạy thật)
FRONTEND_URL=https://ten-mien-frontend.vercel.app

# Chạy sau proxy (Render, Nginx, Cloudflare...) thì đặt 1 để req.ip là IP khách thật (cần cho giới hạn đăng nhập sai)
TRUST_PROXY=1
