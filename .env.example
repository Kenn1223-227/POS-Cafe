PORT=3000
NODE_ENV=production

# Chuỗi kết nối PostgreSQL (Supabase PgBouncer cổng 6543 + role app_runtime NOBYPASSRLS)
DATABASE_URL=postgresql://app_runtime:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Chuỗi kết nối Direct (5432, quyền owner) chỉ dùng khi chạy scripts/run-migration.js
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# Chuỗi kết nối riêng cho Platform Super Admin (tách biệt hoàn toàn với DATABASE_URL của app_runtime).
# Bắt buộc sau Migration 039 (app_runtime bị thu hồi EXECUTE 6 hàm public.fn_platform_*).
# Khuyến nghị Production: tạo role riêng ít quyền nhất chỉ có EXECUTE trên 6 hàm fn_platform_* (hoặc dùng kết nối quản trị tách biệt).
# Nếu bỏ trống, db.js tự fallback có kiểm soát sang MIGRATION_DATABASE_URL (giới hạn tối đa 3 connections).
PLATFORM_DATABASE_URL=

# BẮT BUỘC >= 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# [Phân hệ 7] Access Token ngắn hạn + Refresh Token Rotation (HttpOnly Cookie) & Store Device Session
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_DAYS=7
JWT_DEVICE_SESSION_DAYS=30
# Cookie Cross-Domain & HTTPS:
# - COOKIE_SAMESITE: 'Lax' (mặc định cho cùng domain / local dev), 'Strict', hoặc 'None' (bắt buộc khi Frontend Vercel và Backend Render/Fly khác domain).
# - Khi cấu hình COOKIE_SAMESITE=None, hệ thống tự động ép Secure=true (theo chuẩn RFC 6265bis, trình duyệt sẽ từ chối nếu thiếu Secure).
# - COOKIE_SECURE: để trống để tự động nhận diện (dựa trên HTTPS / req.secure / trust proxy / production), hoặc ép 'true'/'false'.
COOKIE_SECURE=
COOKIE_SAMESITE=Lax

# Domain frontend được phép gọi API/Socket, ngăn cách bằng dấu phẩy (BẮT BUỘC cấu hình trên Production)
FRONTEND_URL=https://ten-mien-frontend.vercel.app

# Reverse Proxy (Render, Vercel, Fly.io, Railway, Nginx, Cloudflare...):
# - Đặt 1 (hoặc true) để Express tin tưởng reverse proxy cấp 1.
# - Giúp req.secure nhận diện chính xác HTTPS từ header X-Forwarded-Proto và req.ip nhận diện đúng IP khách thật từ X-Forwarded-For.
# - Mặc định tự động kích hoạt (=1) trên Production (NODE_ENV=production) nếu chưa đặt.
TRUST_PROXY=1

# [Phân hệ 7] Redis (Always-On Multi-Instance: @socket.io/redis-adapter + Distributed Rate Limiting)
# RÀNG BUỘC VẬN HÀNH PILOT (5-15 quán): BẮT BUỘC Scale = 1 instance Backend trên Render/Fly.
# (Do pinFailMap và printRelayTenants đang lưu trên RAM server; chỉ bật multi-instance sau khi chuyển 2 map này lên Redis).
# Cài thêm `npm i ioredis @socket.io/redis-adapter` khi bật cluster nhiều instance
REDIS_URL=

# [Phân hệ 7] Observability & Alerting (Structured JSON Logging + Slow Query Alert + Sentry)
LOG_LEVEL=info
LOG_FORMAT=json
SLOW_QUERY_MS=500
SENTRY_DSN=

# Cho phép bán hàng khi tồn kho âm (mặc định true để không gián đoạn giờ cao điểm, đặt false để chặn cứng)
ALLOW_NEGATIVE_STOCK=true

# Webhook VietQR tự động (tùy chọn: cấu hình SePay và/hoặc PayOS)
# SePay gửi header: Authorization: Apikey <SEPAY_API_KEY> -> POST /api/webhooks/sepay/:tenantSlug
SEPAY_API_KEY=
# PayOS dùng HMAC-SHA256 với Checksum Key -> POST /api/webhooks/payos/:tenantSlug
PAYOS_CHECKSUM_KEY=

# Gemini Vision API Key (tùy chọn cho AI Menu Importer đọc ảnh chụp tờ menu giấy)
GEMINI_API_KEY=

# Tài khoản Platform Super Admin độc lập (cổng /super-admin, tách biệt khỏi mọi quán kể cả DEFAULT)
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Super Admin
